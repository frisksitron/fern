{
  "name": "fern",
  "version": "1.0.0",
  "description": "Stream the movies, shows, and music in your folders to any browser on your home network",
  "license": "MIT",
  "scripts": {
    "test": "vitest run --project unit --project integration",
    "test:db": "vitest run --project db",
    "prepare": "svelte-kit sync || echo ''",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mockmedia": "node scripts/create-mock-media.mjs",
    "dbgenerate": "drizzle-kit generate",
    "dbmigrate": "drizzle-kit migrate",
    "e2e": "node scripts/run-e2e.mjs",
    "zerogenerate": "drizzle-zero generate --config drizzle-zero.config.ts --output src/lib/zero/schema.ts --format --suppress-defaults-warning"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "@effect/platform-node": "4.0.0",
    "@effect/sql-pg": "4.0.0",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@rocicorp/zero": "1.9.0",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "drizzle-orm": "1.0.0-rc.5-5935859",
    "effect": "4.0.0",
    "hls.js": "^1.7.3",
    "media-chrome": "^4.19.2",
    "pg": "^8.23.0",
    "svelte": "^5.57.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "1.0.0-rc.5-5935859",
    "drizzle-zero": "1.0.0-beta.1",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "private": true
}

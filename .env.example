# Settings for Fern's docker-compose.yml. Copy to .env next to it and set MEDIA_PATH; the rest is optional.
# Local development doesn't use this file: its defaults already point at docker-compose.dev.yml.

# Folder with your media on this machine. Fern mounts it read-only at /media. The container's fern
# user (uid 100, gid 101) must be able to read it.
MEDIA_PATH=/mnt/media

# Where songs downloaded from YouTube are saved, if you want them in a folder on this machine. Fern
# shows them as its own YouTube library. Empty keeps them in a Docker volume. The folder must be
# writable by the container's fern user (uid 100, gid 101).
DOWNLOADS_PATH=

# Port Fern is served on. Open http://<this machine's address>:<PORT>.
PORT=8080

# Image tag: latest, or sha-<commit> to stay on one build.
FERN_VERSION=latest

# Passwords Fern's own containers use to talk to each other. Postgres isn't reachable from outside
# the Compose network, and Fern has no login of its own, so these only need changing if you want to.
POSTGRES_PASSWORD=fern
ZERO_ADMIN_PASSWORD=fern

# Folders the media picker can browse, inside the container. Separate with ":".
BROWSE_ROOTS=/media

# Tuning. Empty values use the defaults listed in the README.
HLS_CACHE_MAX_BYTES=
HLS_CACHE_MAX_AGE_HOURS=
THUMBNAIL_CACHE_MAX_BYTES=
THUMBNAIL_CACHE_MAX_AGE_HOURS=
TRACK_MAP_CACHE_MAX_BYTES=
TRACK_MAP_CACHE_MAX_AGE_HOURS=
MAX_CONCURRENT_TRANSCODES=
TRANSCODE_MAX_WAITING=
TRANSCODE_THREADS=
TRANSCODE_ACCELERATOR=
SCAN_PROBE_CONCURRENCY=
LOG_LEVEL=
LOG_FORMAT=json
SHUTDOWN_TIMEOUT=10
